@{
    ViewData["Title"] = "Personagens";
}

<section class="personagens">

    <h1>Personagens Principais</h1>

    <div class="personagens-grid">

        <div class="personagem-card">
            <img src="https://i.pinimg.com/236x/21/04/a6/2104a6c0d3a78039bfac4fcac6a039b7.jpg" alt="Anakin Skywalker">

            <h3>Anakin Skywalker / Darth Vader</h3>

            <p>
                Herói das Guerras Clônicas que acaba seduzido pelo lado sombrio da Força,
                tornando-se Darth Vader.
            </p>
        </div>

        <div class="personagem-card">
            <img src="https://tm.ibxk.com.br/2022/05/27/27104601505097.jpg?ims=1200x900" alt="Obi-Wan Kenobi">

            <h3>Obi-Wan Kenobi</h3>

            <p>
                Mestre Jedi e mentor de Anakin. Faz de tudo para impedir sua queda.
            </p>
        </div>

        <div class="personagem-card">
            <img src="https://static.wikia.nocookie.net/starwars/images/b/b2/Padmegreenscrshot.jpg/revision/latest?cb=20100423143631" alt="Padmé Amidala">

            <h3>Padmé Amidala</h3>

            <p>
                Senadora de Naboo e esposa secreta de Anakin Skywalker.
            </p>
        </div>

        <div class="personagem-card">
            <img src="https://upload.wikimedia.org/wikipedia/en/8/8f/Emperor_RotJ.png" alt="Palpatine">

            <h3>Palpatine</h3>

            <p>
                Chanceler Supremo que revela sua verdadeira identidade como Darth Sidious.
            </p>
        </div>

        <div class="personagem-card">
            <img src="https://preview.redd.it/as-someone-who-only-just-finished-episode-3-and-only-v0-u0p4r1icfwxc1.jpeg?auto=webp&s=b9bd67639135afb744625e028cbc00e0598f5cbe" alt="Yoda">

            <h3>Yoda</h3>

            <p>
                Grande Mestre da Ordem Jedi que tenta impedir a ascensão do Império.
            </p>
        </div>

        <div class="personagem-card">
            <img src="https://encrypted-tbn0.gstatic.com/images?q=tbn:ANd9GcTzeJyMJt1uzW10MTbFJ73E9ZQMkQoouNLUJT2VDntGZw&s=10" alt="General Grievous">

            <h3>General Grievous</h3>

            <p>
                Líder militar Separatista e um dos maiores inimigos dos Jedi.
            </p>
        </div>

    </div>

</section>