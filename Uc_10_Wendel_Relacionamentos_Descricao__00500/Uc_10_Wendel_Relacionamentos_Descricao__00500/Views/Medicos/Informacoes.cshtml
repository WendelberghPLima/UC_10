@{
    ViewData["Title"] = "Informações dos Médicos";
}

<div class="page-content">
    <h1>Informações dos Médicos</h1>

    <p>
        O Hospital Vida+ conta com profissionais qualificados
        para oferecer atendimento de qualidade aos pacientes.
    </p>

    <div class="info-card">
        <h3>Especialidades médicas</h3>
        <p>
            Clínica geral, cardiologia, pediatria e outras
            áreas de atendimento.
        </p>
    </div>

    <div class="info-card">
        <h3>Cadastro profissional</h3>
        <p>
            Cada médico possui nome, especialidade e CRM
            registrados no sistema.
        </p>
    </div>

    <a asp-action="Index" class="btn btn-primary">
        Voltar para médicos
    </a>
</div>