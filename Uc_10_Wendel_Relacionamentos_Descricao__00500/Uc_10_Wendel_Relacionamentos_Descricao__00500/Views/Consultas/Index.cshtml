@model IEnumerable<Uc_10_Wendel_Relacionamentos_Descricao__00500.Models.Consulta>

@{
    ViewData["Title"] = "Index";
}

<h1>Consulta</h1>

<p>
    <a asp-action="Create">Criar Novo</a>
</p>
<table class="table">
    <thead>
        <tr>
            <th>
                @Html.DisplayNameFor(model => model.Data)
            </th>
            <th>
                @Html.DisplayNameFor(model => model.Observacao)
            </th>
            <th>
                @Html.DisplayNameFor(model => model.Paciente)
            </th>
            <th>
                @Html.DisplayNameFor(model => model.Medico)
            </th>
            <th>
                @Html.DisplayNameFor(model => model.TipoConsulta)
            </th>
            <th></th>
        </tr>
    </thead>
    <tbody>
@foreach (var item in Model) {
        <tr>
            <td>
                @Html.DisplayFor(modelItem => item.Data)
            </td>
            <td>
                @Html.DisplayFor(modelItem => item.Observacao)
            </td>
            <td>
                @Html.DisplayFor(modelItem => item.Paciente.Nome)
            </td>
            <td>
                @Html.DisplayFor(modelItem => item.Medico.CRM)
            </td>
            <td>
                @Html.DisplayFor(modelItem => item.TipoConsulta.Nome)
            </td>
            <td>
                <a asp-action="Edit" asp-route-id="@item.ConsultaId">Editar</a> |
                <a asp-action="Details" asp-route-id="@item.ConsultaId">Detalhes</a> |
                <a asp-action="Delete" asp-route-id="@item.ConsultaId">Excluir</a>
            </td>
        </tr>
}
    </tbody>
</table>
