@{
    ViewData["Title"] = "Informações das Consultas";
}

<div class="page-content">
    <h1>Informações das Consultas</h1>

    <p>
        O sistema de consultas auxilia na organização dos
        atendimentos realizados pelo hospital.
    </p>

    <div class="info-card">
        <h3>Organização</h3>
        <p>
            As consultas podem ser relacionadas a pacientes,
            médicos e tipos de consulta.
        </p>
    </div>

    <div class="info-card">
        <h3>Controle administrativo</h3>
        <p>
            Mantenha os registros de consultas organizados
            para facilitar o gerenciamento hospitalar.
        </p>
    </div>

    <a asp-action="Index" class="btn btn-primary">
        Voltar para consultas
    </a>
</div>