@model Uc_10_Wendel_Relacionamentos_Descricao__00500.Models.Consulta

@{
    ViewData["Title"] = "Edit";
}

<h1>Editar</h1>

<h4>Consulta</h4>
<hr />
<div class="row">
    <div class="col-md-4">
        <form asp-action="Edit">
