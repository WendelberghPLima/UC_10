@model IEnumerable<Uc_10_Wendel_Relacionamentos_Descricao__00500.Models.TipoConsulta>

@{
    ViewData["Title"] = "Index";
}

<h1>Tipo de Consulta</h1>

<p>
    <a asp-action="Create">Criar Novo</a>
</p>
<table class="table">
    <thead>
        <tr>
            <th>
                @Html.DisplayNameFor(model => model.Nome)
            </th>
            <th>
                @Html.DisplayNameFor(model => model.Descricao)
            </th>
            <th></th>
        </tr>
    </thead>
    <tbody>
@foreach (var item in Model) {
        <tr>
            <td>
                @Html.DisplayFor(modelItem => item.Nome)
            </td>
            <td>
                @Html.DisplayFor(modelItem => item.Descricao)
            </td>
            <td>
                <a asp-action="Edit" asp-route-id="@item.TipoConsultaId">Editar</a> |
                <a asp-action="Details" asp-route-id="@item.TipoConsultaId">Detalhes</a> |
                <a asp-action="Delete" asp-route-id="@item.TipoConsultaId">Excluir</a>
            </td>
        </tr>
}
    </tbody>
</table>
