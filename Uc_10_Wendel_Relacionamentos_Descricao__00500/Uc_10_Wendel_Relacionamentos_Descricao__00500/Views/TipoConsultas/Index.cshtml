@model IEnumerable<Uc_10_Wendel_Relacionamentos_Descricao__00500.Models.TipoConsulta>

@{
    ViewData["Title"] = "Tipos de consulta";
}

<div class="page">

    <div class="page-header">
        <div>
            <span class="page-label">SISTEMA HOSPITALAR</span>

            <h1>Gerenciamento de tipos de consulta</h1>

            <p>
                Consulte, cadastre e organize os tipos de consulta do sistema.
            </p>
        </div>

        <a asp-action="Create" class="btn btn-primary">
            + Cadastrar tipo de consulta
        </a>
    </div>


    <!-- AÇÕES RÁPIDAS -->

    <div class="quick-actions">

        <a asp-action="Informacoes" class="action-card">
            <div class="action-icon">ⓘ</div>

            <div>
                <strong>Informações</strong>
                <span>Veja informações sobre os tipos de consulta.</span>
            </div>
        </a>


        <a asp-action="Orientacoes" class="action-card">
            <div class="action-icon">✓</div>

            <div>
                <strong>Orientações</strong>
                <span>Confira orientações para o cadastro.</span>
            </div>
        </a>

    </div>


    <!-- TABELA -->

    <div class="table-card">

        <div class="table-header">

            <div>
                <h2>Tipos de consulta cadastrados</h2>

                <p>
                    Lista de tipos de consulta registrados no sistema.
                </p>
            </div>

        </div>


        <div class="table-responsive">

            <table class="data-table">

                <thead>

                    <tr>

                        <th>Nome</th>

                        <th>Descrição</th>

                        <th>Ações</th>

                    </tr>

                </thead>


                <tbody>

                    @foreach (var item in Model)
                    {
                        <tr>

                            <td>

                                <span class="avatar">
                                    @item.Nome?.Substring(0, 1).ToUpper()
                                </span>

                                <strong>
                                    @item.Nome
                                </strong>

                            </td>


                            <td>

                                <span class="badge badge-primary">
                                    @item.Descricao
                                </span>

                            </td>

                            <td class="table-actions">

                                <a asp-action="Edit"
                                   asp-route-id="@item.TipoConsultaId"
                                   class="action-edit">
                                    Editar
                                </a>

                                <a asp-action="Details"
                                   asp-route-id="@item.TipoConsultaId"
                                   class="action-details">
                                    Detalhes
                                </a>

                                <a asp-action="Delete"
                                   asp-route-id="@item.TipoConsultaId"
                                   class="action-delete">
                                    Excluir
                                </a>

                            </td>

                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </div>
</div>