@{
    ViewData["Title"] = "Orientações dos Tipos de Consulta";
}

<div class="page-content">
    <h1>Orientações dos Tipos de Consulta</h1>

    <p>
        Os tipos de consulta devem possuir nomes claros
        para facilitar a identificação dos atendimentos.
    </p>

    <ul>
        <li>Utilize nomes objetivos.</li>
        <li>Evite cadastrar tipos repetidos.</li>
        <li>Mantenha as informações organizadas.</li>
    </ul>

    <a asp-action="Index" class="btn btn-primary">
        Voltar para tipos de consulta
    </a>
</div>