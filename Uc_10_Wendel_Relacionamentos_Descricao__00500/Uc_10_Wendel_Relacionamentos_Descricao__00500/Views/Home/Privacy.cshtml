@{
    ViewData["Title"] = "Sobre o Hospital";
}

<div class="page-content">
    <h1>Sobre o Hospital Vida+</h1>

    <p>
        O Hospital Vida+ é uma instituição fictícia criada para
        oferecer atendimento humanizado e organizado.
    </p>

    <p>
        Nosso sistema facilita o gerenciamento de médicos,
        pacientes, consultas e tipos de consulta.
    </p>

    <h2>Nossos objetivos</h2>

    <ul>
        <li>Organizar os dados dos pacientes.</li>
        <li>Facilitar o cadastro de médicos.</li>
        <li>Controlar os atendimentos.</li>
        <li>Melhorar a organização administrativa.</li>
    </ul>
</div>