@{
    ViewData["Title"] = "Início";
}

<div class="hospital-hero">
    <div>
        <span class="tag">HOSPITAL VIDA+</span>

        <h1>Cuidando de pessoas com organização e eficiência.</h1>

        <p>
            Sistema administrativo para gerenciar médicos,
            pacientes e consultas de forma simples.
        </p>

        <a asp-controller="Home" asp-action="Privacy"
           class="btn-hospital">
            Conheça o hospital
        </a>
    </div>

    <div class="hospital-image">
        <img src="https://images.unsplash.com/photo-1586773860418-d37222d8fce3?w=900"
             alt="Ambiente hospitalar">
    </div>
</div>

<section class="section-home">
    <h2>Administração hospitalar</h2>

    <div class="info-grid">
        <div class="info-card">
            <h3>Médicos</h3>
            <p>Cadastro e organização dos profissionais.</p>
            <a asp-controller="Medicos" asp-action="Index">
                Acessar médicos
            </a>
        </div>

        <div class="info-card">
            <h3>Pacientes</h3>
            <p>Controle dos pacientes cadastrados.</p>
            <a asp-controller="Pacientes" asp-action="Index">
                Acessar pacientes
            </a>
        </div>

        <div class="info-card">
            <h3>Consultas</h3>
            <p>Organização dos atendimentos.</p>
            <a asp-controller="Consultas" asp-action="Index">
                Acessar consultas
            </a>
        </div>

        <div class="info-card">
            <h3>Tipos de consulta</h3>
            <p>Gerenciamento das especialidades de atendimento.</p>
            <a asp-controller="TipoConsultas" asp-action="Index">
                Acessar tipos
            </a>
        </div>
    </div>
</section>